#!/usr/bin/env bash

eval "$(jq -r '@sh "
MODEL_DISPLAY=\(.model.display_name)
TOTAL_COST=\(.cost.total_cost_usd // 0)
LINES_ADDED=\(.cost.total_lines_added // 0)
LINES_REMOVED=\(.cost.total_lines_removed // 0)
CTX_WINDOW_SIZE=\(.context_window.context_window_size // 0)
TOKENS=\(.context_window.current_usage | if . then .input_tokens + .cache_creation_input_tokens + .cache_read_input_tokens else 0 end)
FIVE_H=\(.rate_limits.five_hour.used_percentage // "")
WEEK=\(.rate_limits.seven_day.used_percentage // "")
FIVE_H_RESETS=\(.rate_limits.five_hour.resets_at // "")
WEEK_RESETS=\(.rate_limits.seven_day.resets_at // "")
"')"

lines=()
for part in "${BASH_SOURCE[0]}.d"/*.sh; do
        source "$part"
done

for line in "${lines[@]}"; do
        echo -e "$line"
done
